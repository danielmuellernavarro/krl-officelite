&ACCESS RVP
&REL 1
DEF demo()
  INT i

  ;FOLD INI
  $ADVANCE = 3
  $VEL.CP = 1.5
  $ACC.CP = 2.3
  nParts = 0
  $OUT[1] = FALSE
  ;ENDFOLD (INI)

  PTP XHOME

  FOR i = 1 TO 3
    ; wait until a part is there (force $IN[1] in the KRL I/O view)
    WAIT FOR PART_PRESENT

    PTP XOVER C_PTP
    LIN XPICK
    GRIPPER_CLOSE = TRUE
    WAIT SEC 0.3
    LIN XOVER C_DIS

    PTP XPLACE
    GRIPPER_CLOSE = FALSE
    WAIT SEC 0.3

    nParts = nParts + 1
  ENDFOR

  PTP XHOME
END
