    "Message (MsgNotify)": {
        "prefix": "set_krlmsg",
        "body": [
            "DECL KRLMSG_T ${1:msg}",
            "DECL KRLMSGPAR_T ${2:par}[3]",
            "DECL KRLMSGOPT_T ${3:opt}",
            "INT ${4:handle}",
            "${1:msg} = {MODUL[] \"${5:USER}\", NR ${6:1}, MSG_TXT[] \"${7:text %1}\"}",
            "${3:opt} = {VL_STOP TRUE, CLEAR_P_RESET TRUE, CLEAR_P_SAW FALSE, LOG_TO_DB FALSE}",
            "${4:handle} = SET_KRLMSG(#${8|NOTIFY,QUIT,STATE,WAITING|}, ${1:msg}, ${2:par}[], ${3:opt})"
