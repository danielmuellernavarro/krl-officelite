{
    "name": "krl-officelite",
    "displayName": "KUKA KRL OfficeLite",
    "description": "KUKA KRL for VS Code: smart completion, error checking with quick fixes, formatter and a debugger that simulates the robot controller (advance run, motion timing, I/O, override, T1/T2/AUT modes)",
    "version": "2.0.2",
    "publisher": "krl-officelite",
    "license": "MIT",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Linters",
        "Snippets",
        "Debuggers"
    ],
    "keywords": [
        "kuka",
        "krl",
        "robot",
        "robotics",
        "industrial robot",
        "kss",
        "officelite",
        "smartpad",
        "src",
        "dat",
        "sps",
        "debugger",
        "simulation",
        "formatter",
        "linter"
    ],
    "galleryBanner": {
        "color": "#2B2B2B",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/danielmuellernavarro/krl-officelite.git"
    },
    "activationEvents": [
        "onLanguage:krl",
        "onDebugResolve:krl",
        "onView:krlLiveWatch",
        "onCommand:krl.searchVariables",
        "onView:krlRobot",
        "onView:krlIo",
        "onCommand:krl.simulation.setOverride",
        "onCommand:krl.simulation.setMode"
    ],
    "main": "./out/extension.js",
    "icon": "images/icon.png",
    "bugs": "https://github.com/danielmuellernavarro/krl-officelite/issues",
    "contributes": {
        "configuration": {
            "title": "krl-officelite configuration",
            "type": "object",
            "properties": {
                "krl-officelite.indentwidth": {
                    "type": "integer",
                    "default": 2,
                    "description": "Number of spaces used for indentation"
                },
                "krl-officelite.separateBeforeBlocks": {
                    "type": "boolean",
                    "default": false,
                    "description": "Add newlines before and before blocks (for, if, while, loop etc.)"
                },
                "krl-officelite.separateAfterBlocks": {
                    "type": "boolean",
                    "default": false,
                    "description": "Add newlines before and after blocks (for, if, while, loop etc.)"
                },
                "krl-officelite.indentAfterFunction": {
                    "type": "boolean",
                    "default": true,
                    "description": "Add indentation for functions"
                },
                "krl-officelite.indentAfterMainFunction": {
                    "type": "boolean",
                    "default": false,
                    "description": "If indent after function is true. Add indentation for the main function too"
                },
                "krl-officelite.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Format KRL files when they are saved (not on auto save after a delay). Only the changed lines are touched, so the cursor stays; a file whose blocks do not match (e.g. IF without ENDIF) is saved unformatted. Not needed when editor.formatOnSave is on for KRL."
                },
                "krl-officelite.diagnostics.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check KRL files while editing: block structure, ;FOLD pairs, declarations, I/O ranges, velocity limits."
                },
                "krl-officelite.diagnostics.allFiles": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check all KRL files of the workspace, not only the open ones: their syntax errors and warnings show in Problems."
                },
                "krl-officelite.diagnostics.undeclared": {
                    "type": "boolean",
                    "default": true,
                    "description": "Report names and routines that are not declared. Needs a project with $config.dat (KRC/R1/System) so that all globals are known (points of motions included: they can be global, too)."
                },
                "krl-officelite.diagnostics.unused": {
                    "type": "boolean",
                    "default": true,
                    "description": "Fade declarations that are never used: local variables and the data list entries of a module (e.g. points left over from deleted motions)."
                },
                "krl-officelite.safety.maxCartesianVelocity": {
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "description": "Commissioning limit for the path velocity in m/s: higher values of $VEL.CP, BAS(#VEL_CP / #CP_PARAMS), SVEL_CP and LDAT data are reported."
                },
                "krl-officelite.io.count": {
                    "type": "integer",
                    "default": 4096,
                    "minimum": 1,
                    "maximum": 8192,
                    "description": "Number of digital inputs and outputs of the controller ($IN / $OUT indices above it are reported)."
                },
                "krl-officelite.simulation.override": {
                    "type": "number",
                    "default": 100,
                    "minimum": 0,
                    "maximum": 10000,
                    "markdownDescription": "Override in % for new KRL debug sessions, like on the smartPAD: 0 .. 100 % is the program override `$OV_PRO` (the motions slow down, 0 % = the robot stands); above 100 % (up to 10000 %) the whole simulation runs faster than real time. Change it while debugging with − / + in the debug toolbar, the status bar or the KRL Robot view."
                },
                "krl-officelite.simulation.mode": {
                    "type": "string",
                    "enum": [
                        "T1",
                        "T2",
                        "AUT",
                        "EX"
                    ],
                    "default": "T1",
                    "enumDescriptions": [
                        "Manual reduced velocity: the path at most $VEL_CP_T1 (250 mm/s), the axes at $RED_T1 % (machine data)",
                        "Manual high velocity: programmed velocity",
                        "Automatic",
                        "Automatic external (EXT)"
                    ],
                    "markdownDescription": "Operating mode (`$MODE_OP`) for new KRL debug sessions. Change it in the debug toolbar or the status bar while the program is paused, like the key switch of the smartPAD."
                },
                "krl-officelite.inlayHints.motionParameters": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the velocity, acceleration and approximation of motions (from the inline form data, WITH clause or the last $VEL / BAS before it)."
                },
                "krl-officelite.inlayHints.parameterNames": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show parameter names before literal arguments of routine calls."
                },
                "krl-officelite.folding.autoCollapse": {
                    "type": "string",
                    "enum": [
                        "none",
                        "inlineForms",
                        "all"
                    ],
                    "enumDescriptions": [
                        "Show everything.",
                        "Collapse the ;FOLD of inline forms (PTP P1 Vel=100 % ...) when a file is opened, like the smartPAD.",
                        "Collapse every ;FOLD when a file is opened."
                    ],
                    "default": "inlineForms",
                    "description": "Which ;FOLD regions are collapsed when a KRL file is opened."
                },
                "krl-officelite.folding.dimInlineFormParameters": {
                    "type": "boolean",
                    "default": true,
                    "description": "Dim the parameters of inline form ;FOLD lines (;%{PE}%R 8.3...)."
                }
            }
        },
        "languages": [
            {
                "id": "krl",
                "aliases": [
                    "KRL",
                    "krl"
                ],
                "extensions": [
                    ".dat",
                    ".src",
                    ".sub"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "krl",
                "scopeName": "source.krl",
                "path": "./syntaxes/krl.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "krl",
                "path": "./snippets/krl.json"
            }
        ],
        "views": {
