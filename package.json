        "debuggers": [
            {
                "type": "krl",
                "label": "KRL Debug",
                "languages": [
                    "krl"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Absolute path to the KRL program to debug. A .src runs in the robot interpreter (with the submit programs alongside); a .sub runs alone in the submit interpreter.",
                                "default": "${file}"
                            },
                            "submitPrograms": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Paths to the .sub programs that run in submit interpreters next to the main program, one thread each. If omitted, SPS.SUB is started (like the controller does), found next to the program or below the robot root such as KRC/R1/System; without SPS.SUB, all .sub files next to the program run. Other .sub files are loaded so they can be called as subprograms.",
                                "default": []
                            },
                            "sources": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Further .src/.dat files whose routines and globals the programs use. If omitted, all modules below the robot root (the folder holding System/$config.dat, e.g. KRC/R1) are loaded.",
                                "default": []
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Break automatically on the first executable statement.",
                                "default": true
                            },
                            "configDat": {
                                "type": "string",
                                "description": "Path to $config.dat. If omitted the extension searches upward from the program's folder automatically, including System subfolders."
                            },
                            "override": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 10000,
                                "description": "Override in % (0 .. 10000): up to 100 % the program override $OV_PRO, above it the simulation runs faster than real time. Defaults to the setting krl-officelite.simulation.override."
                            },
                            "machineData": {
                                "type": "string",
                                "description": "Path to the robot's $machine.dat (axis speeds, gear ratios, path limits) for the motion timing. If omitted, Mada/$machine.dat is searched in the robot root (e.g. KRC/R1/Mada) and the folders above the program; without it a standard robot is simulated."
                            },
                            "mode": {
                                "type": "string",
                                "enum": [
                                    "T1",
                                    "T2",
                                    "AUT",
                                    "EX"
                                ],
                                "description": "Operating mode ($MODE_OP) at the start. Defaults to the setting krl-officelite.simulation.mode (T1)."
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "krl",
                        "request": "launch",
                        "name": "KRL: Debug",
                        "program": "${file}",
                        "stopOnEntry": true
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "KRL: Debug Program",
                        "description": "Debug a KRL main program (and optional submit programs)",
                        "body": {
                            "type": "krl",
                            "request": "launch",
                            "name": "KRL: Debug",
                            "program": "${file}",
                            "submitPrograms": [],
                            "stopOnEntry": true,
                            "configDat": ""
                        }
                    }
                ]
            }
        ],
        "configurationDefaults": {
            "[krl]": {
                "editor.suggest.snippetsPreventQuickSuggestions": false
            }
        }
