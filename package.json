        "menus": {
            "view/title": [
                {
                    "command": "krl.messages.acknowledgeAll",
                    "when": "view == krlMessages",
                    "group": "navigation"
                },
                {
                    "command": "krl.searchVariables",
                    "when": "view == krlLiveWatch",
                    "group": "navigation@0"
                },
                {
                    "command": "krl.liveWatch.add",
                    "when": "view == krlLiveWatch",
                    "group": "navigation@1"
                },
                {
                    "command": "krl.liveWatch.removeAll",
                    "when": "view == krlLiveWatch",
                    "group": "navigation@2"
                },
                {
                    "command": "krl.searchVariables",
                    "when": "view == workbench.debug.variablesView && debugType == 'krl'",
                    "group": "navigation"
                },
                {
                    "command": "krl.io.add",
                    "when": "view == krlIo",
                    "group": "navigation@1"
                },
                {
                    "command": "krl.io.clearPinned",
                    "when": "view == krlIo",
                    "group": "navigation@2"
                },
                {
                    "command": "krl.simulation.decreaseOverride",
                    "when": "view == krlRobot && debugType == 'krl'",
                    "group": "navigation@1"
                },
                {
                    "command": "krl.simulation.setOverride",
                    "when": "view == krlRobot && debugType == 'krl'",
                    "group": "navigation@2"
                },
                {
                    "command": "krl.simulation.increaseOverride",
                    "when": "view == krlRobot && debugType == 'krl'",
                    "group": "navigation@3"
                },
                {
                    "command": "krl.simulation.setMode",
                    "when": "view == krlRobot && debugType == 'krl'",
                    "group": "navigation@4"
                }
            ],
            "view/item/context": [
                {
                    "command": "krl.messages.acknowledge",
                    "when": "view == krlMessages && viewItem =~ /^krlMessage\\.(quit|notify|waiting)$/",
                    "group": "inline"
                },
                {
                    "command": "krl.messages.answer",
                    "when": "view == krlMessages && viewItem == krlMessage.dialog",
                    "group": "inline"
                },
                {
                    "command": "krl.liveWatch.remove",
                    "when": "view == krlLiveWatch && viewItem == krlLiveWatchExpression",
                    "group": "inline"
                },
                {
                    "command": "krl.io.toggle",
                    "when": "view == krlIo && viewItem == krlIo.bool",
                    "group": "inline"
                },
                {
                    "command": "krl.io.set",
                    "when": "view == krlIo && viewItem =~ /^krlIo./",
                    "group": "inline"
                },
                {
                    "command": "krl.robot.addToLiveWatch",
                    "when": "view == krlRobot && viewItem == krlRobotEntry",
                    "group": "inline"
                },
                {
                    "command": "krl.simulation.decreaseOverride",
                    "when": "view == krlRobot && viewItem == krlRobotOverride",
                    "group": "inline@1"
                },
                {
                    "command": "krl.simulation.setOverride",
                    "when": "view == krlRobot && viewItem == krlRobotOverride",
                    "group": "inline@2"
                },
                {
                    "command": "krl.simulation.increaseOverride",
                    "when": "view == krlRobot && viewItem == krlRobotOverride",
                    "group": "inline@3"
                },
                {
                    "command": "krl.simulation.setMode",
                    "when": "view == krlRobot && viewItem == krlRobotMode",
                    "group": "inline@1"
                }
            ],
            "debug/callstack/context": [
                {
                    "command": "krl.interpreter.stop",
                    "when": "debugType == 'krl' && callStackItemType == 'thread'",
                    "group": "krl@1"
                },
                {
                    "command": "krl.interpreter.start",
                    "when": "debugType == 'krl' && callStackItemType == 'thread'",
                    "group": "krl@2"
                },
                {
                    "command": "krl.interpreter.restart",
                    "when": "debugType == 'krl' && callStackItemType == 'thread'",
                    "group": "krl@3"
                },
                {
                    "command": "krl.interpreter.startSubmit",
                    "when": "debugType == 'krl' && callStackItemType == 'thread'",
                    "group": "krl@4"
                }
            ],
            "debug/variables/context": [
                {
                    "command": "krl.liveWatch.addVariable",
                    "when": "debugType == 'krl'",
                    "group": "z_commands"
                }
            ],
            "editor/context": [
                {
                    "command": "krl.liveWatch.addSelection",
                    "when": "inDebugMode && debugType == 'krl' && editorLangId == krl",
                    "group": "debug@100"
                },
                {
                    "command": "krl.io.toggleAtCursor",
                    "when": "inDebugMode && debugType == 'krl' && editorLangId == krl",
                    "group": "debug@101"
                },
                {
                    "command": "krl.fold.wrapSelection",
                    "when": "editorLangId == krl && editorHasSelection",
                    "group": "1_modification@9"
                }
            ],
            "commandPalette": [
                {
                    "command": "krl.messages.acknowledgeAll",
                    "when": "debugType == 'krl'"
                },
                {
                    "command": "krl.messages.acknowledge",
                    "when": "false"
                },
                {
                    "command": "krl.messages.answer",
                    "when": "false"
                },
                {
                    "command": "krl.interpreter.stop",
                    "when": "debugType == 'krl'"
                },
                {
                    "command": "krl.interpreter.start",
                    "when": "debugType == 'krl'"
                },
                {
                    "command": "krl.interpreter.restart",
                    "when": "debugType == 'krl'"
                },
                {
                    "command": "krl.interpreter.startSubmit",
                    "when": "debugType == 'krl'"
                },
                {
                    "command": "krl.searchVariables",
                    "when": "debugType == 'krl'"
                },
                {
                    "command": "krl.liveWatch.add",
                    "when": "debugType == 'krl'"
                },
                {
                    "command": "krl.liveWatch.addVariable",
                    "when": "false"
                },
                {
                    "command": "krl.liveWatch.addSelection",
                    "when": "debugType == 'krl' && editorLangId == krl"
                },
                {
                    "command": "krl.liveWatch.remove",
                    "when": "false"
                },
                {
                    "command": "krl.io.toggle",
                    "when": "false"
                },
                {
                    "command": "krl.io.set",
                    "when": "false"
                },
                {
                    "command": "krl.robot.addToLiveWatch",
                    "when": "false"
                },
                {
                    "command": "krl.dat.declare",
